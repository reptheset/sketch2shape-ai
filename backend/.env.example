# Copy to backend/.env and adjust. Never commit the real .env file.

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where job folders (uploads, generated images, GLB files) are stored
DATA_DIR=./data

# Upload and prompt limits
MAX_UPLOAD_MB=10
MAX_PROMPT_CHARS=500

# Side length of the cleaned, square sketch passed to the AI stages
SKETCH_SIZE=1024

# ---- Stage 3: semantic enrichment (vision LLM) ----
# Provider: groq (default) or openai. Both use the same OpenAI-compatible client.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# Fail the job when the model says the upload is clearly not a sketch (e.g. a selfie)
REJECT_NON_SKETCHES=true

# ---- Stage 4: sketch-guided image generation (local, open-source) ----
# SDXL base 1.0 + xinsir ControlNet Scribble SDXL + fp16-fix VAE, via diffusers.
# Weights (~10 GB) download from Hugging Face on first use; no account or token needed.
SD_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SD_CONTROLNET_MODEL=xinsir/controlnet-scribble-sdxl-1.0
SD_VAE_MODEL=madebyollin/sdxl-vae-fp16-fix
# auto picks cuda (NVIDIA) > mps (Apple Silicon) > cpu
SD_DEVICE=auto
# Fewer steps = faster, slightly less detail (20-30 is a good range)
SD_STEPS=30
SD_GUIDANCE_SCALE=7.0
# Recommended on Apple Silicon with < 64 GB memory
SD_ATTENTION_SLICING=true
# Lower to 768 if the computer runs out of memory
IMAGE_SIZE=1024
# Load the models when the server starts, so the first job does not wait for loading
PRELOAD_MODELS=true

# ---- Stage 5: background removal (local, open-source) ----
# rembg model: u2net (default, ~170 MB), isnet-general-use, or birefnet-general (sharper, larger)
REMBG_MODEL=u2net
# Output size of the isolated object image and empty margin around it (fraction per side)
FOREGROUND_SIZE=1024
FOREGROUND_MARGIN=0.08

# ---- Stage 6: 3D reconstruction ----
# Providers tried in order. trellis = free Hugging Face Space (best quality, daily GPU quota),
# triposr = local fallback on this computer (always available). Use "triposr" alone to work offline.
RECON_PROVIDERS=trellis,triposr
# Free Hugging Face "Read" token: https://huggingface.co/settings/tokens
# Without it the Space allows ~2 GPU-minutes/day; with a free account ~5 (about 5-8 models).
HF_TOKEN=
TRELLIS_SPACE=trellis-community/TRELLIS
# Sampling steps: 12 = Space default (fastest), 20-25 = cleaner shapes for a few more GPU-seconds
TRELLIS_SS_STEPS=20
TRELLIS_SS_GUIDANCE=7.5
TRELLIS_SLAT_STEPS=20
TRELLIS_SLAT_GUIDANCE=3.0
# 0.95 = keep 5% of the faces (smaller file); TRELLIS's own default
TRELLIS_MESH_SIMPLIFY=0.95
TRELLIS_TEXTURE_SIZE=1024
# Give up on the Space (queue + generation) after this and use the fallback
TRELLIS_TIMEOUT_SECONDS=300
# After a quota error, skip the Space for this long
TRELLIS_QUOTA_COOLDOWN_MINUTES=30
# Local TripoSR (set up once with: python -m scripts.setup_triposr)
TRIPOSR_DIR=./vendor/TripoSR
TRIPOSR_MODEL=stabilityai/TripoSR
# auto picks cuda > mps > cpu (falls back to cpu if mps lacks an operation)
TRIPOSR_DEVICE=auto
# Marching-cubes grid size: 256 = detailed, 192 = faster
TRIPOSR_MC_RESOLUTION=256
TRIPOSR_CHUNK_SIZE=8192

# ---- Stage 7: mesh validation ----
# Centre the model, rest it on the ground and scale its largest side to MESH_TARGET_SIZE metres
MESH_NORMALIZE=true
MESH_TARGET_SIZE=1.0
